# ---- Server ----
PORT=3013
NODE_ENV=production
SESSION_SECRET=change-me-long-random
# Base URL used for the Steam OpenID return URL when the Host header is absent
PUBLIC_BASE_URL=http://localhost:3013
# Set to false when the client build is served by nginx/a CDN instead of this
# process (in dev the CRA server on :3000 proxies to :3013 anyway)
SERVE_CLIENT=

# ---- Steam ----
STEAM_API_KEY=your-steam-api-key
ADMIN_STEAM_ID=76561198000000000
# Optional extra admins, comma separated
ADMIN_STEAM_IDS=
# Game whose inventory the Trade view loads. Any Steam game works:
# CS2 is 730, TF2 440, Dota 2 570. Context 2 is the tradable inventory
# for most games. Leave the app id empty to disable the Trade view.
STEAM_INVENTORY_APP_ID=
STEAM_INVENTORY_CONTEXT_ID=2

# ---- Tari wallet daemon (esmeralda testnet) ----
OOTLE_WALLETD_URL=http://127.0.0.1:5100/json_rpc
OOTLE_WALLETD_TOKEN_FILE=/path/to/api-key-file
# Hot/escrow account this DApp pays from
OOTLE_HOT_ACCOUNT=dapp-escrow
# Optional: admin token file for automatic testnet faucet refills into dapp-escrow
OOTLE_MINT_ADMIN_KEY_FILE=
OOTLE_ESCROW_TARGET_TARI=20000

# ---- DApp behavior ----
# Where JSON stores live (defaults to ./server/data)
DAPP_DATA_DIR=
# Item catalog JSON for pretend drops: [{name, imageUrl, priceUsd, typeLabel, rarityLabel}]
ITEM_CATALOG_FILE=
# Feature flags (defaults are safe)
OOTLE_ENABLE_TRANSFERS=false
OOTLE_FAUCET_ENABLED=true
OOTLE_PREDICTIONS_ENABLED=true

# ---- Client (build time) ----
REACT_APP_HOME_URL=https://your-main-site.example
